model Voucher {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  code              String        @unique @db.VarChar(50)
  name              String        @db.VarChar(255)
  scope             VoucherScope
  discountType      DiscountType
  discountValue     Decimal       @db.Decimal(12, 2)
  minOrderAmount    Decimal?      @db.Decimal(12, 2)
  maxDiscountAmount Decimal?      @db.Decimal(12, 2)
  quantity          Int
  usedQuantity      Int           @default(0)
  perUserLimit      Int           @default(1)
  startDate         DateTime
  endDate           DateTime
  status            VoucherStatus @default(draft)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  details VoucherDetail[]

  @@index([userId])
  @@index([scope])
  @@index([status, startDate, endDate])
}

model VoucherDetail {
  id             String    @id @default(uuid()) @db.Uuid
  voucherId      String    @db.Uuid
  productId      String?   @db.Uuid
  orderId        String?   @db.Uuid
  eligibleAmount Decimal?  @db.Decimal(12, 2)
  discountAmount Decimal?  @db.Decimal(12, 2)
  sequence       Int?
  createdAt      DateTime  @default(now())
  reversedAt     DateTime?

  voucher Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, productId])
  @@unique([voucherId, orderId])
  @@unique([orderId, sequence])
  @@index([voucherId])
  @@index([productId])
  @@index([orderId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @db.Uuid
  vendorId    String?       @db.Uuid
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  description String?       @db.Text
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor         User?           @relation("VendorProducts", fields: [vendorId], references: [id], onDelete: Restrict)
  colors         ProductColor[]
  reviews        Review[]
  voucherDetails VoucherDetail[]

  @@index([categoryId])
  @@index([vendorId])
  @@index([status])
}

model ProductColor {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  color     String    @db.VarChar(100)
  imageUrls String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([productId, color])
  @@index([productId])
}

model ProductVariant {
  id             String    @id @default(uuid()) @db.Uuid
  productColorId String    @db.Uuid
  size           String    @db.VarChar(50)
  stock          Int       @default(0)
  size           String    @db.VarChar(100)
  price          Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  productColor ProductColor  @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderDetails OrderDetail[]

  @@index([productColorId])
}

model Review {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  productId     String    @db.Uuid
  orderDetailId String    @unique @db.Uuid
  content       String?   @db.Text
  rating        Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderDetail OrderDetail @relation(fields: [orderDetailId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
}

model Cart {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  productVariantId String   @db.Uuid
  cartId           String   @db.Uuid
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([productVariantId])
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderCode       String      @unique @default(cuid()) @db.VarChar(50)
  userId          String      @db.Uuid
  subtotalAmount  Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(pending)
  notes           String?     @db.VarChar(1000)
  receiverName    String?     @db.VarChar(255)
  receiverPhone   String?     @db.VarChar(50)
  shippingAddress String?     @db.VarChar(500)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  cancelledAt     DateTime?

  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  details        OrderDetail[]
  payment        Payment?
  voucherDetails VoucherDetail[]
  statusHistory  OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderDetail {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @db.Uuid
  productVariantId String  @db.Uuid
  quantity         Int
  price            Decimal @db.Decimal(12, 2)
  productName      String? @db.VarChar(255)
  colorName        String? @db.VarChar(100)
  sizeName         String? @db.VarChar(100)
  imageUrl         String? @db.VarChar(1000)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  review         Review?

  @@unique([orderId, productVariantId])
  @@index([productVariantId])
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @unique @db.Uuid
  method          PaymentMethod
  amount          Decimal       @default(0) @db.Decimal(12, 2)
  status          PaymentStatus @default(pending)
  transactionCode String?       @unique @db.VarChar(255)
  gateway         String?       @db.VarChar(100)
  gatewayResponse Json?
  paidAt          DateTime?
  failedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  actorId    String?      @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?      @db.VarChar(1000)
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorId])
}
