generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "zod-prisma-types"
  output   = "../src/generated/zod"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  vendor
  admin
}

enum UserStatus {
  active
  inactive
}

enum SurveyStatus {
  draft
  active
  closed
}

enum VoucherStatus {
  draft
  active
  inactive
  expired
}

enum VoucherScope {
  platform
  vendor
}

enum DiscountType {
  percentage
  fixed_amount
}

enum ProductStatus {
  draft
  active
  inactive
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipping
  completed
  cancelled
}

enum PaymentMethod {
  cod
  vnpay
  momo
  zalopay
  bank_transfer
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  fullName             String               @db.VarChar(255)
  email                String               @unique @db.VarChar(255)
  password             String               @db.VarChar(255)
  address              String?              @db.VarChar(500)
  phone                String?              @db.VarChar(255)
  role                 UserRole             @default(customer)
  status               UserStatus           @default(active)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  createdBy            String?              @db.VarChar(255)
  // surveys         Survey[]         @relation("SurveyCreator")
  // surveyResponses SurveyResponse[] @relation("SurveyRespondent")
  vouchers             Voucher[]
  reviews              Review[]
  cart                 Cart?
  orders               Order[]
  products             Product[]            @relation("VendorProducts")
  orderStatusHistories OrderStatusHistory[] @relation("OrderStatusActor")
}

