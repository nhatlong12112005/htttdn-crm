generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS (ADMIN, CLIENT, CRM & ORDERS)
// ==========================================

enum UserStatus {
  active
  inactive
}

enum SurveyStatus {
  draft
  active
  closed
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum SurveyScope {
  platform
  vendor
}

enum SurveyAudienceType {
  all_users
  all_vendors
  all_system
  selected_users
  vendor_buyers
  vendor_completed_buyers
  vendor_product_buyers
}

enum SurveyTriggerType {
  manual
  after_checkout
  after_order_completed
}

enum SurveyResponseStatus {
  pending
  submitted
  skipped
  expired
}

enum NotificationType {
  survey_invitation
  order_update
  system
}

enum SurveyQuestionType {
  text
  single_choice
  multiple_choice
  rating
}

enum VoucherStatus {
  draft
  active
  inactive
  expired
}

enum VoucherScope {
  platform
  vendor
}

enum DiscountType {
  percentage
  fixed_amount
}

enum ProductStatus {
  draft
  active
  inactive
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipping
  completed
  cancelled
  returned
}

enum PaymentMethod {
  cod
  vnpay
  momo
  zalopay
  bank_transfer
  credit_card
  pay_later
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

// ==========================================
// 2. ACCOUNT TABLES (ADMIN & CLIENT)
// ==========================================

model Admin {
  id          String     @id @default(uuid()) @db.Uuid
  fullName    String     @db.VarChar(255)
  email       String     @unique @db.VarChar(255)
  password    String     @db.VarChar(255)
  phone       String?    @db.VarChar(255)
  avatarUrl   String?    @db.VarChar(1000)
  department  String?    @db.VarChar(255)
  roleCode    String     @default("CRM_MANAGER") @db.VarChar(50)
  permissions Json?
  status      UserStatus @default(active)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  surveys              Survey[]             @relation("AdminSurveyCreator")
  notifications        Notification[]       @relation("AdminNotification")
  vouchers             Voucher[]            @relation("AdminVoucher")
  orderStatusHistories OrderStatusHistory[] @relation("AdminOrderStatusActor")
}

model Client {
  id            String     @id @default(uuid()) @db.Uuid
  fullName      String     @db.VarChar(255)
  email         String     @unique @db.VarChar(255)
  password      String     @db.VarChar(255)
  phone         String?    @db.VarChar(255)
  avatarUrl     String?    @db.VarChar(1000)
  dateOfBirth   DateTime?  @db.Date
  gender        Gender?
  loyaltyPoints Int        @default(0)
  status        UserStatus @default(active)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  surveyResponses      SurveyResponse[]     @relation("ClientSurveyRespondent")
  notifications        Notification[]       @relation("ClientNotification")
  productFavorites     ProductFavorite[]
  addresses            ClientAddress[]
  reviews              Review[]
  cart                 Cart?
  orders               Order[]
  orderStatusHistories OrderStatusHistory[] @relation("ClientOrderStatusActor")
}

model ClientAddress {
  id           String    @id @default(uuid()) @db.Uuid
  clientId     String    @db.Uuid
  receiverName String    @db.VarChar(255)
  phone        String    @db.VarChar(50)
  addressLine  String    @db.VarChar(500)
  ward         String?   @db.VarChar(255)
  district     String?   @db.VarChar(255)
  province     String?   @db.VarChar(255)
  label        String?   @db.VarChar(100)
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, deletedAt])
}

// ==========================================
// 3. CRM MODULE (SURVEYS & NOTIFICATIONS)
// ==========================================

model Survey {
  id           String             @id @default(uuid()) @db.Uuid
  adminId      String?            @db.Uuid
  title        String             @db.VarChar(255)
  description  String?            @db.Text
  imageUrl     String?            @db.VarChar(1000)
  scope        SurveyScope        @default(platform)
  audienceType SurveyAudienceType
  recipientIds String[]           @default([]) @db.Uuid
  triggerType  SurveyTriggerType  @default(manual)
  status       SurveyStatus       @default(draft)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  admin         Admin?           @relation("AdminSurveyCreator", fields: [adminId], references: [id], onDelete: Restrict)
  questions     SurveyQuestion[]
  responses     SurveyResponse[]
  notifications Notification[]

  @@index([adminId])
  @@index([status, triggerType, startDate, endDate])
}

model SurveyQuestion {
  id        String             @id @default(uuid()) @db.Uuid
  surveyId  String             @db.Uuid
  question  String             @db.Text
  type      SurveyQuestionType
  required  Boolean            @default(false)
  position  Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options SurveyOption[]
  answers SurveyAnswer[]

  @@unique([surveyId, position])
  @@index([surveyId])
}

model SurveyOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  content    String   @db.VarChar(500)
  position   Int
  createdAt  DateTime @default(now())

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@unique([questionId, position])
  @@index([questionId])
}

model SurveyResponse {
  id          String               @id @default(uuid()) @db.Uuid
  surveyId    String               @db.Uuid
  clientId    String               @db.Uuid
  orderId     String?              @db.Uuid
  deliveryKey String               @unique @db.VarChar(255)
  status      SurveyResponseStatus @default(pending)
  notifiedAt  DateTime?
  openedAt    DateTime?
  submittedAt DateTime?
  skippedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  survey       Survey         @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  client       Client         @relation("ClientSurveyRespondent", fields: [clientId], references: [id], onDelete: Restrict)
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  answers      SurveyAnswer[]
  notification Notification?

  @@index([surveyId, status])
  @@index([clientId, status, createdAt])
  @@index([orderId, status])
}

model SurveyAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  responseId  String   @db.Uuid
  questionId  String   @db.Uuid
  optionId    String?  @db.Uuid
  textAnswer  String?  @db.Text
  ratingValue Int?
  createdAt   DateTime @default(now())

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option   SurveyOption?  @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@index([responseId])
  @@index([questionId])
  @@index([optionId])
}

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  adminId          String?          @db.Uuid
  clientId         String?          @db.Uuid
  surveyId         String?          @db.Uuid
  surveyResponseId String?          @unique @db.Uuid
  type             NotificationType
  title            String           @db.VarChar(255)
  content          String?          @db.Text
  data             Json?
  isRead           Boolean          @default(false)
  readAt           DateTime?
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())

  admin    Admin?          @relation("AdminNotification", fields: [adminId], references: [id], onDelete: Cascade)
  client   Client?         @relation("ClientNotification", fields: [clientId], references: [id], onDelete: Cascade)
  survey   Survey?         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  response SurveyResponse? @relation(fields: [surveyResponseId], references: [id], onDelete: Cascade)

  @@index([adminId, isRead, createdAt])
  @@index([clientId, isRead, createdAt])
  @@index([surveyId])
}

// ==========================================
// 4. VOUCHERS, CATALOG & PRODUCTS
// ==========================================

model Voucher {
  id                String        @id @default(uuid()) @db.Uuid
  adminId           String?       @db.Uuid
  code              String        @unique @db.VarChar(50)
  name              String        @db.VarChar(255)
  scope             VoucherScope
  discountType      DiscountType
  discountValue     Decimal       @db.Decimal(12, 2)
  minOrderAmount    Decimal?      @db.Decimal(12, 2)
  maxDiscountAmount Decimal?      @db.Decimal(12, 2)
  quantity          Int
  usedQuantity      Int           @default(0)
  perUserLimit      Int           @default(1)
  startDate         DateTime
  endDate           DateTime
  status            VoucherStatus @default(draft)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  admin   Admin?          @relation("AdminVoucher", fields: [adminId], references: [id], onDelete: Restrict)
  details VoucherDetail[]

  @@index([adminId])
  @@index([scope])
  @@index([status, startDate, endDate])
}

model VoucherDetail {
  id             String    @id @default(uuid()) @db.Uuid
  voucherId      String    @db.Uuid
  productId      String?   @db.Uuid
  orderId        String?   @db.Uuid
  eligibleAmount Decimal?  @db.Decimal(12, 2)
  discountAmount Decimal?  @db.Decimal(12, 2)
  sequence       Int?
  createdAt      DateTime  @default(now())
  reversedAt     DateTime?

  voucher Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, productId])
  @@unique([voucherId, orderId])
  @@unique([orderId, sequence])
  @@index([voucherId])
  @@index([productId])
  @@index([orderId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @db.Uuid
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  description String?       @db.Text
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  colors         ProductColor[]
  reviews        Review[]
  voucherDetails VoucherDetail[]
  favorites      ProductFavorite[]

  @@index([categoryId])
  @@index([status])
}

model ProductFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@index([clientId, createdAt])
  @@index([productId])
}

model ProductColor {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  color     String    @db.VarChar(100)
  imageUrls String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([productId, color])
  @@index([productId])
}

model ProductVariant {
  id             String    @id @default(uuid()) @db.Uuid
  productColorId String    @db.Uuid
  size           String    @db.VarChar(50)
  stock          Int       @default(0)
  price          Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  productColor ProductColor  @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderDetails OrderDetail[]

  @@unique([productColorId, size])
  @@index([productColorId])
}

// ==========================================
// 5. REVIEWS (PRODUCT FEEDBACK & CRM REPLY)
// ==========================================

model Review {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String    @db.Uuid
  productId     String    @db.Uuid
  orderDetailId String?   @unique @db.Uuid
  content       String?   @db.Text
  rating        Int
  adminReply    String?   @db.Text
  repliedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderDetail OrderDetail? @relation(fields: [orderDetailId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([productId])
}

// ==========================================
// 6. CART, ORDERS & PAYMENTS
// ==========================================

model Cart {
  id        String    @id @default(uuid()) @db.Uuid
  clientId  String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  productVariantId String   @db.Uuid
  cartId           String   @db.Uuid
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([productVariantId])
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderCode       String      @unique @default(cuid()) @db.VarChar(50)
  clientId        String      @db.Uuid
  subtotalAmount  Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(pending)
  notes           String?     @db.VarChar(1000)
  receiverName    String?     @db.VarChar(255)
  receiverPhone   String?     @db.VarChar(50)
  shippingAddress String?     @db.VarChar(500)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  cancelledAt     DateTime?

  client          Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  details         OrderDetail[]
  payment         Payment?
  voucherDetails  VoucherDetail[]
  statusHistory   OrderStatusHistory[]
  surveyResponses SurveyResponse[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model OrderDetail {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @db.Uuid
  productVariantId String  @db.Uuid
  quantity         Int
  price            Decimal @db.Decimal(12, 2)
  productName      String? @db.VarChar(255)
  colorName        String? @db.VarChar(100)
  sizeName         String? @db.VarChar(100)
  imageUrl         String? @db.VarChar(1000)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  review         Review?

  @@unique([orderId, productVariantId])
  @@index([productVariantId])
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @unique @db.Uuid
  method          PaymentMethod
  amount          Decimal       @default(0) @db.Decimal(12, 2)
  status          PaymentStatus @default(pending)
  transactionCode String?       @unique @db.VarChar(255)
  gateway         String?       @db.VarChar(100)
  gatewayResponse Json?
  paidAt          DateTime?
  refundedAt      DateTime?
  failedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  adminId    String?      @db.Uuid
  clientId   String?      @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?      @db.VarChar(1000)
  createdAt  DateTime     @default(now())

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin  Admin?  @relation("AdminOrderStatusActor", fields: [adminId], references: [id], onDelete: SetNull)
  client Client? @relation("ClientOrderStatusActor", fields: [clientId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([adminId])
  @@index([clientId])
}
