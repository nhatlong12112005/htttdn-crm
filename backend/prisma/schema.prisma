generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "zod-prisma-types"
  output   = "../src/generated/zod"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  vendor
  admin
}

enum UserStatus {
  active
  inactive
}

enum SurveyStatus {
  draft
  active
  closed
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum SurveyScope {
  platform
  vendor
}

enum SurveyAudienceType {
  all_users
  all_vendors
  all_system
  selected_users
  vendor_buyers
  vendor_completed_buyers
  vendor_product_buyers
}

enum SurveyTriggerType {
  manual
  after_checkout
  after_order_completed
}

enum SurveyResponseStatus {
  pending
  submitted
  skipped
  expired
}

enum NotificationType {
  survey_invitation
  order_update
  system
}

enum SurveyQuestionType {
  text
  single_choice
  multiple_choice
  rating
}

enum VoucherStatus {
  draft
  active
  inactive
  expired
}

enum VoucherScope {
  platform
  vendor
}

enum DiscountType {
  percentage
  fixed_amount
}

enum ProductStatus {
  draft
  active
  inactive
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipping
  completed
  cancelled
}

enum PaymentMethod {
  cod
  vnpay
  momo
  zalopay
  bank_transfer
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  fullName             String               @db.VarChar(255)
  email                String               @unique @db.VarChar(255)
  password             String               @db.VarChar(255)
  address              String?              @db.VarChar(500)
  phone                String?              @db.VarChar(255)
  dateOfBirth          DateTime?            @db.Date
  gender               Gender?
  role                 UserRole             @default(customer)
  status               UserStatus           @default(active)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  createdBy            String?              @db.VarChar(255)
  surveys              Survey[]             @relation("SurveyCreator")
  surveyResponses      SurveyResponse[]     @relation("SurveyRespondent")
  notifications        Notification[]
  productFavorites     ProductFavorite[]
  vouchers             Voucher[]
  reviews              Review[]
  cart                 Cart?
  orders               Order[]
  products             Product[]            @relation("VendorProducts")
  orderStatusHistories OrderStatusHistory[] @relation("OrderStatusActor")
}

model Survey {
  id           String             @id @default(uuid()) @db.Uuid
  createdById  String             @db.Uuid
  title        String             @db.VarChar(255)
  description  String?            @db.Text
  imageUrl     String?            @db.VarChar(1000)
  scope        SurveyScope        @default(platform)
  audienceType SurveyAudienceType
  triggerType  SurveyTriggerType  @default(manual)
  status       SurveyStatus       @default(draft)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  createdBy     User             @relation("SurveyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  questions     SurveyQuestion[]
  responses     SurveyResponse[]
  notifications Notification[]

  @@index([createdById])
  @@index([status, triggerType, startDate, endDate])
}

model SurveyQuestion {
  id        String             @id @default(uuid()) @db.Uuid
  surveyId  String             @db.Uuid
  question  String             @db.Text
  type      SurveyQuestionType
  required  Boolean            @default(false)
  position  Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options SurveyOption[]
  answers SurveyAnswer[]

  @@unique([surveyId, position])
  @@index([surveyId])
}

model SurveyOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  content    String   @db.VarChar(500)
  position   Int
  createdAt  DateTime @default(now())

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@unique([questionId, position])
  @@index([questionId])
}

model SurveyResponse {
  id          String               @id @default(uuid()) @db.Uuid
  surveyId    String               @db.Uuid
  userId      String               @db.Uuid
  orderId     String?              @db.Uuid
  deliveryKey String               @unique @db.VarChar(255)
  status      SurveyResponseStatus @default(pending)
  notifiedAt  DateTime?
  openedAt    DateTime?
  submittedAt DateTime?
  skippedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  survey       Survey         @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  user         User           @relation("SurveyRespondent", fields: [userId], references: [id], onDelete: Restrict)
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  answers      SurveyAnswer[]
  notification Notification?

  @@index([surveyId, status])
  @@index([userId, status, createdAt])
  @@index([orderId, status])
}

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  surveyId         String?          @db.Uuid
  surveyResponseId String?          @unique @db.Uuid
  type             NotificationType
  title            String           @db.VarChar(255)
  content          String?          @db.Text
  data             Json?
  isRead           Boolean          @default(false)
  readAt           DateTime?
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  survey   Survey?         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  response SurveyResponse? @relation(fields: [surveyResponseId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([surveyId])
}

model SurveyAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  responseId  String   @db.Uuid
  questionId  String   @db.Uuid
  optionId    String?  @db.Uuid
  textAnswer  String?  @db.Text
  ratingValue Int?
  createdAt   DateTime @default(now())

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option   SurveyOption?  @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@index([responseId])
  @@index([questionId])
  @@index([optionId])
}

model Voucher {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  code              String        @unique @db.VarChar(50)
  name              String        @db.VarChar(255)
  scope             VoucherScope
  discountType      DiscountType
  discountValue     Decimal       @db.Decimal(12, 2)
  minOrderAmount    Decimal?      @db.Decimal(12, 2)
  maxDiscountAmount Decimal?      @db.Decimal(12, 2)
  quantity          Int
  usedQuantity      Int           @default(0)
  perUserLimit      Int           @default(1)
  startDate         DateTime
  endDate           DateTime
  status            VoucherStatus @default(draft)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  details VoucherDetail[]

  @@index([userId])
  @@index([scope])
  @@index([status, startDate, endDate])
}

model VoucherDetail {
  id             String    @id @default(uuid()) @db.Uuid
  voucherId      String    @db.Uuid
  productId      String?   @db.Uuid
  orderId        String?   @db.Uuid
  eligibleAmount Decimal?  @db.Decimal(12, 2)
  discountAmount Decimal?  @db.Decimal(12, 2)
  sequence       Int?
  createdAt      DateTime  @default(now())
  reversedAt     DateTime?

  voucher Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, productId])
  @@unique([voucherId, orderId])
  @@unique([orderId, sequence])
  @@index([voucherId])
  @@index([productId])
  @@index([orderId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @db.Uuid
  vendorId    String?       @db.Uuid
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  description String?       @db.Text
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor         User?             @relation("VendorProducts", fields: [vendorId], references: [id], onDelete: Restrict)
  colors         ProductColor[]
  reviews        Review[]
  voucherDetails VoucherDetail[]
  favorites      ProductFavorite[]

  @@index([categoryId])
  @@index([vendorId])
  @@index([status])
}

model ProductFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model ProductColor {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  color     String    @db.VarChar(100)
  imageUrls String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([productId, color])
  @@index([productId])
}

model ProductVariant {
  id             String    @id @default(uuid()) @db.Uuid
  productColorId String    @db.Uuid
  size           String    @db.VarChar(50)
  stock          Int       @default(0)
  price          Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  productColor ProductColor  @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderDetails OrderDetail[]

  @@unique([productColorId, size])
  @@index([productColorId])
}

model Review {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  productId     String    @db.Uuid
  orderDetailId String    @unique @db.Uuid
  content       String?   @db.Text
  rating        Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderDetail OrderDetail @relation(fields: [orderDetailId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
}

model Cart {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  productVariantId String   @db.Uuid
  cartId           String   @db.Uuid
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([productVariantId])
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderCode       String      @unique @default(cuid()) @db.VarChar(50)
  userId          String      @db.Uuid
  subtotalAmount  Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(pending)
  notes           String?     @db.VarChar(1000)
  receiverName    String?     @db.VarChar(255)
  receiverPhone   String?     @db.VarChar(50)
  shippingAddress String?     @db.VarChar(500)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  cancelledAt     DateTime?

  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  details         OrderDetail[]
  payment         Payment?
  voucherDetails  VoucherDetail[]
  statusHistory   OrderStatusHistory[]
  surveyResponses SurveyResponse[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderDetail {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @db.Uuid
  productVariantId String  @db.Uuid
  quantity         Int
  price            Decimal @db.Decimal(12, 2)
  productName      String? @db.VarChar(255)
  colorName        String? @db.VarChar(100)
  sizeName         String? @db.VarChar(100)
  imageUrl         String? @db.VarChar(1000)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  review         Review?

  @@unique([orderId, productVariantId])
  @@index([productVariantId])
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @unique @db.Uuid
  method          PaymentMethod
  amount          Decimal       @default(0) @db.Decimal(12, 2)
  status          PaymentStatus @default(pending)
  transactionCode String?       @unique @db.VarChar(255)
  gateway         String?       @db.VarChar(100)
  gatewayResponse Json?
  paidAt          DateTime?
  failedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  actorId    String?      @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?      @db.VarChar(1000)
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorId])
}
