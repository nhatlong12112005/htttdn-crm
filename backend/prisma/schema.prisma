generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "zod-prisma-types"
  output   = "../src/generated/zod"
  createRelationValuesTypes = false
  createInclude = false
  createSelect = false
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
}

enum SurveyStatus {
  draft
  active
  closed
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum SurveyScope {
  platform
  vendor
}

enum SurveyAudienceType {
  all_users
  all_vendors
  all_system
  selected_users
  vendor_buyers
  vendor_completed_buyers
  vendor_product_buyers
}

enum SurveyTriggerType {
  manual
  after_checkout
  after_order_completed
}

enum SurveyResponseStatus {
  pending
  submitted
  skipped
  expired
}

enum NotificationType {
  survey_invitation
  order_update
  system
}

enum SurveyQuestionType {
  text
  single_choice
  multiple_choice
  rating
}

enum VoucherStatus {
  draft
  active
  inactive
  expired
}

enum VoucherScope {
  platform
  vendor
}

enum DiscountType {
  percentage
  fixed_amount
}

enum ProductStatus {
  draft
  active
  inactive
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipping
  completed
  cancelled
}

enum PaymentMethod {
  cod
  vnpay
  momo
  zalopay
  bank_transfer
  credit_card
  pay_later
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum EmploymentType {
  full_time
  part_time
}

enum AttendanceStatus {
  present
  absent
  late
  leave
}

enum PayrollStatus {
  draft
  approved
  paid
}

enum VendorOrderStatus {
  pending
  confirmed
  processing
  ready_for_pickup
  shipping
  delivered
  cancelled
}

enum ShipmentStatus {
  pending
  assigned
  picking_up
  in_transit
  out_for_delivery
  delivered
  failed
  returned
}

model Admin {
  id         String     @id @default(uuid()) @db.Uuid
  fullName   String     @db.VarChar(255)
  email      String     @unique @db.VarChar(255)
  password   String     @db.VarChar(255)
  phone      String?    @db.VarChar(255)
  avatarUrl  String?    @db.VarChar(1000)
  department String?    @db.VarChar(255)
  status     UserStatus @default(active)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  surveys              Survey[]             @relation("AdminSurveyCreator")
  notifications        Notification[]       @relation("AdminNotification")
  vouchers             Voucher[]            @relation("AdminVoucher")
  orderStatusHistories OrderStatusHistory[] @relation("AdminOrderStatusActor")
  createdEmployees     Employee[]           @relation("AdminCreatedEmployees")
  createdSalaryHistories EmployeeSalaryHistory[] @relation("AdminSalaryModifier")
}

model Employee {
  id                 String     @id @default(uuid()) @db.Uuid
  employeeCode       String     @unique @db.VarChar(50)
  fullName           String     @db.VarChar(255)
  email              String     @unique @db.VarChar(255)
  password           String     @db.VarChar(255)
  phone              String?    @db.VarChar(50)
  avatarUrl          String?    @db.VarChar(1000)
  dateOfBirth        DateTime?  @db.Date
  gender             Gender?
  citizenId          String?    @db.VarChar(50)
  address            String?    @db.VarChar(500)
  department         String     @db.VarChar(100)
  position           String         @db.VarChar(100)
  employmentType     EmploymentType @default(full_time)
  salary             Decimal        @default(0) @db.Decimal(12, 2)
  hourlyRate         Decimal?       @db.Decimal(12, 2)
  hireDate           DateTime       @db.Date
  status             UserStatus     @default(active)
  assignedOrderScope String         @default("assigned_orders") @db.VarChar(100)
  permissions        Json?
  adminId            String?        @db.Uuid
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  createdBy            Admin?                  @relation("AdminCreatedEmployees", fields: [adminId], references: [id], onDelete: SetNull)
  salaryHistories      EmployeeSalaryHistory[]
  attendances          EmployeeAttendance[]
  payrolls             EmployeePayroll[]
  orderStatusHistories OrderStatusHistory[]    @relation("EmployeeOrderStatusActor")
  assignedShipments    Shipment[]              @relation("EmployeeAssignedShipment")

  @@index([adminId])
  @@index([status])
  @@index([department])
}

model Client {
  id            String     @id @default(uuid()) @db.Uuid
  fullName      String     @db.VarChar(255)
  email         String     @unique @db.VarChar(255)
  password      String     @db.VarChar(255)
  phone         String?    @db.VarChar(255)
  avatarUrl     String?    @db.VarChar(1000)
  dateOfBirth   DateTime?  @db.Date
  gender        Gender?
  loyaltyPoints Int        @default(0)
  status        UserStatus @default(active)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  surveyResponses      SurveyResponse[]     @relation("ClientSurveyRespondent")
  notifications        Notification[]       @relation("ClientNotification")
  productFavorites     ProductFavorite[]
  addresses            ClientAddress[]
  reviews              Review[]
  cart                 Cart?
  orders               Order[]
  orderStatusHistories OrderStatusHistory[] @relation("ClientOrderStatusActor")
}

model Vendor {
  id        String     @id @default(uuid()) @db.Uuid
  fullName  String     @db.VarChar(255)
  email     String     @unique @db.VarChar(255)
  password  String     @db.VarChar(255)
  phone     String?    @db.VarChar(255)
  avatarUrl String?    @db.VarChar(1000)
  storeName String?    @db.VarChar(255)
  taxId     String?    @db.VarChar(100)
  status                UserStatus @default(active)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  subscriptionPlan      String?    @default("1_year") @db.VarChar(50)
  subscriptionFee       Decimal?   @default(1200000) @db.Decimal(12, 2)
  subscriptionExpiresAt DateTime?  @db.Timestamp(6)
  commissionRate        Decimal    @default(8.0) @db.Decimal(5, 2)
  approvalStatus        String     @default("approved") @db.VarChar(50)
  approvedAt            DateTime?
  approvedBy            String?    @db.VarChar(255)
  rejectedReason        String?    @db.VarChar(500)
  renewalRequested      Boolean    @default(false)
  renewalPlan           String?    @db.VarChar(50)
  renewalRequestedAt    DateTime?

  surveys              Survey[]             @relation("VendorSurveyCreator")
  notifications        Notification[]       @relation("VendorNotification")
  products             Product[]            @relation("VendorProducts")
  vouchers             Voucher[]            @relation("VendorVoucher")
  orderStatusHistories OrderStatusHistory[] @relation("VendorOrderStatusActor")
  vendorOrders         VendorOrder[]        @relation("VendorOrders")
}

model Survey {
  id           String             @id @default(uuid()) @db.Uuid
  adminId      String?            @db.Uuid
  vendorId     String?            @db.Uuid
  title        String             @db.VarChar(255)
  description  String?            @db.Text
  imageUrl     String?            @db.VarChar(1000)
  scope        SurveyScope        @default(platform)
  audienceType SurveyAudienceType
  triggerType  SurveyTriggerType  @default(manual)
  status       SurveyStatus       @default(draft)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  admin         Admin?           @relation("AdminSurveyCreator", fields: [adminId], references: [id], onDelete: Restrict)
  vendor        Vendor?          @relation("VendorSurveyCreator", fields: [vendorId], references: [id], onDelete: Restrict)
  questions     SurveyQuestion[]
  responses     SurveyResponse[]
  notifications Notification[]

  @@index([adminId])
  @@index([vendorId])
  @@index([status, triggerType, startDate, endDate])
}

model SurveyQuestion {
  id        String             @id @default(uuid()) @db.Uuid
  surveyId  String             @db.Uuid
  question  String             @db.Text
  type      SurveyQuestionType
  required  Boolean            @default(false)
  position  Int
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options SurveyOption[]
  answers SurveyAnswer[]

  @@unique([surveyId, position])
  @@index([surveyId])
}

model SurveyOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  content    String   @db.VarChar(500)
  position   Int
  createdAt  DateTime @default(now())

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@unique([questionId, position])
  @@index([questionId])
}

model SurveyResponse {
  id          String               @id @default(uuid()) @db.Uuid
  surveyId    String               @db.Uuid
  clientId    String               @db.Uuid
  orderId     String?              @db.Uuid
  deliveryKey String               @unique @db.VarChar(255)
  status      SurveyResponseStatus @default(pending)
  notifiedAt  DateTime?
  openedAt    DateTime?
  submittedAt DateTime?
  skippedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  survey       Survey         @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  client       Client         @relation("ClientSurveyRespondent", fields: [clientId], references: [id], onDelete: Restrict)
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  answers      SurveyAnswer[]
  notification Notification?

  @@index([surveyId, status])
  @@index([clientId, status, createdAt])
  @@index([orderId, status])
}

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  adminId          String?          @db.Uuid
  clientId         String?          @db.Uuid
  vendorId         String?          @db.Uuid
  surveyId         String?          @db.Uuid
  surveyResponseId String?          @unique @db.Uuid
  type             NotificationType
  title            String           @db.VarChar(255)
  content          String?          @db.Text
  data             Json?
  isRead           Boolean          @default(false)
  readAt           DateTime?
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())

  admin    Admin?          @relation("AdminNotification", fields: [adminId], references: [id], onDelete: Cascade)
  client   Client?         @relation("ClientNotification", fields: [clientId], references: [id], onDelete: Cascade)
  vendor   Vendor?         @relation("VendorNotification", fields: [vendorId], references: [id], onDelete: Cascade)
  survey   Survey?         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  response SurveyResponse? @relation(fields: [surveyResponseId], references: [id], onDelete: Cascade)

  @@index([adminId, isRead, createdAt])
  @@index([clientId, isRead, createdAt])
  @@index([vendorId, isRead, createdAt])
  @@index([surveyId])
}

model SurveyAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  responseId  String   @db.Uuid
  questionId  String   @db.Uuid
  optionId    String?  @db.Uuid
  textAnswer  String?  @db.Text
  ratingValue Int?
  createdAt   DateTime @default(now())

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option   SurveyOption?  @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@index([responseId])
  @@index([questionId])
  @@index([optionId])
}

model Voucher {
  id                String        @id @default(uuid()) @db.Uuid
  adminId           String?       @db.Uuid
  vendorId          String?       @db.Uuid
  code              String        @unique @db.VarChar(50)
  name              String        @db.VarChar(255)
  scope             VoucherScope
  discountType      DiscountType
  discountValue     Decimal       @db.Decimal(12, 2)
  minOrderAmount    Decimal?      @db.Decimal(12, 2)
  maxDiscountAmount Decimal?      @db.Decimal(12, 2)
  quantity          Int
  usedQuantity      Int           @default(0)
  perUserLimit      Int           @default(1)
  startDate         DateTime
  endDate           DateTime
  status            VoucherStatus @default(draft)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  admin   Admin?          @relation("AdminVoucher", fields: [adminId], references: [id], onDelete: Restrict)
  vendor  Vendor?         @relation("VendorVoucher", fields: [vendorId], references: [id], onDelete: Restrict)
  details VoucherDetail[]

  @@index([adminId])
  @@index([vendorId])
  @@index([scope])
  @@index([status, startDate, endDate])
}

model VoucherDetail {
  id             String    @id @default(uuid()) @db.Uuid
  voucherId      String    @db.Uuid
  productId      String?   @db.Uuid
  orderId        String?   @db.Uuid
  eligibleAmount Decimal?  @db.Decimal(12, 2)
  discountAmount Decimal?  @db.Decimal(12, 2)
  sequence       Int?
  createdAt      DateTime  @default(now())
  reversedAt     DateTime?

  voucher Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, productId])
  @@unique([voucherId, orderId])
  @@unique([orderId, sequence])
  @@index([voucherId])
  @@index([productId])
  @@index([orderId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @db.Uuid
  vendorId    String?       @db.Uuid
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  description String?       @db.Text
  status      ProductStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor         Vendor?           @relation("VendorProducts", fields: [vendorId], references: [id], onDelete: Restrict)
  colors         ProductColor[]
  reviews        Review[]
  voucherDetails VoucherDetail[]
  favorites      ProductFavorite[]

  @@index([categoryId])
  @@index([vendorId])
  @@index([status])
}

model ProductFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([clientId, productId])
  @@index([clientId, createdAt])
  @@index([productId])
}

model ClientAddress {
  id           String    @id @default(uuid()) @db.Uuid
  clientId     String    @db.Uuid
  receiverName String    @db.VarChar(255)
  phone        String    @db.VarChar(50)
  addressLine  String    @db.VarChar(500)
  ward         String?   @db.VarChar(255)
  district     String?   @db.VarChar(255)
  province     String?   @db.VarChar(255)
  label        String?   @db.VarChar(100)
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, deletedAt])
}

model ProductColor {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  color     String    @db.VarChar(100)
  imageUrls String[]  @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([productId, color])
  @@index([productId])
}

model ProductVariant {
  id             String    @id @default(uuid()) @db.Uuid
  productColorId String    @db.Uuid
  size           String    @db.VarChar(50)
  stock          Int       @default(0)
  price          Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  productColor ProductColor  @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderDetails OrderDetail[]

  @@unique([productColorId, size])
  @@index([productColorId])
}

model Review {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String    @db.Uuid
  productId     String    @db.Uuid
  orderDetailId String    @unique @db.Uuid
  content       String?   @db.Text
  rating        Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderDetail OrderDetail @relation(fields: [orderDetailId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([productId])
}

model Cart {
  id        String    @id @default(uuid()) @db.Uuid
  clientId  String    @unique @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  productVariantId String   @db.Uuid
  cartId           String   @db.Uuid
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([productVariantId])
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderCode       String      @unique @default(cuid()) @db.VarChar(50)
  clientId        String      @db.Uuid
  subtotalAmount  Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  status          OrderStatus @default(pending)
  notes           String?     @db.VarChar(1000)
  receiverName    String?     @db.VarChar(255)
  receiverPhone   String?     @db.VarChar(50)
  shippingAddress String?     @db.VarChar(500)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  cancelledAt     DateTime?

  client          Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  details         OrderDetail[]
  payment         Payment?
  voucherDetails  VoucherDetail[]
  statusHistory   OrderStatusHistory[]
  surveyResponses SurveyResponse[]
  vendorOrders    VendorOrder[]
  shipments       Shipment[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model OrderDetail {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @db.Uuid
  productVariantId String  @db.Uuid
  quantity         Int
  price            Decimal @db.Decimal(12, 2)
  productName      String? @db.VarChar(255)
  colorName        String? @db.VarChar(100)
  sizeName         String? @db.VarChar(100)
  imageUrl         String? @db.VarChar(1000)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  review         Review?
  vendorOrderId  String?        @db.Uuid
  vendorOrder    VendorOrder?   @relation(fields: [vendorOrderId], references: [id], onDelete: SetNull)

  @@unique([orderId, productVariantId])
  @@index([productVariantId])
  @@index([vendorOrderId])
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @unique @db.Uuid
  method          PaymentMethod
  amount          Decimal       @default(0) @db.Decimal(12, 2)
  status          PaymentStatus @default(pending)
  transactionCode String?       @unique @db.VarChar(255)
  gateway         String?       @db.VarChar(100)
  gatewayResponse Json?
  paidAt          DateTime?
  failedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  adminId    String?      @db.Uuid
  clientId   String?      @db.Uuid
  vendorId   String?      @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?      @db.VarChar(1000)
  createdAt  DateTime     @default(now())

  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin      Admin?    @relation("AdminOrderStatusActor", fields: [adminId], references: [id], onDelete: SetNull)
  client     Client?   @relation("ClientOrderStatusActor", fields: [clientId], references: [id], onDelete: SetNull)
  vendor     Vendor?   @relation("VendorOrderStatusActor", fields: [vendorId], references: [id], onDelete: SetNull)
  employeeId String?   @db.Uuid
  employee   Employee? @relation("EmployeeOrderStatusActor", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([adminId])
  @@index([clientId])
  @@index([vendorId])
  @@index([employeeId])
}

model EmployeeSalaryHistory {
  id             String         @id @default(uuid()) @db.Uuid
  employeeId     String         @db.Uuid
  oldSalary      Decimal?       @db.Decimal(12, 2)
  newSalary      Decimal        @db.Decimal(12, 2)
  oldHourlyRate  Decimal?       @db.Decimal(12, 2)
  newHourlyRate  Decimal?       @db.Decimal(12, 2)
  employmentType EmploymentType @default(full_time)
  effectiveDate  DateTime       @db.Date
  reason         String?        @db.VarChar(500)
  adminId        String?        @db.Uuid
  createdAt      DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  admin    Admin?   @relation("AdminSalaryModifier", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([adminId])
}

model EmployeeAttendance {
  id          String           @id @default(uuid()) @db.Uuid
  employeeId  String           @db.Uuid
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Decimal?         @db.Decimal(5, 2)
  status      AttendanceStatus @default(present)
  note        String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model EmployeePayroll {
  id             String         @id @default(uuid()) @db.Uuid
  employeeId     String         @db.Uuid
  month          Int
  year           Int
  employmentType EmploymentType @default(full_time)
  baseSalary     Decimal        @default(0) @db.Decimal(12, 2)
  hourlyRate     Decimal?       @db.Decimal(12, 2)
  totalHours     Decimal?       @db.Decimal(6, 2)
  allowances     Decimal        @default(0) @db.Decimal(12, 2)
  deductions     Decimal        @default(0) @db.Decimal(12, 2)
  bonus          Decimal        @default(0) @db.Decimal(12, 2)
  netSalary      Decimal        @db.Decimal(12, 2)
  status         PayrollStatus  @default(draft)
  paidAt         DateTime?
  notes          String?        @db.VarChar(1000)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([month, year])
}

model VendorOrder {
  id              String            @id @default(uuid()) @db.Uuid
  vendorOrderCode String            @unique @default(cuid()) @db.VarChar(50)
  orderId         String            @db.Uuid
  vendorId        String            @db.Uuid
  subtotalAmount  Decimal           @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal           @default(0) @db.Decimal(12, 2)
  status          VendorOrderStatus @default(pending)
  notes           String?           @db.VarChar(1000)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor   Vendor        @relation("VendorOrders", fields: [vendorId], references: [id], onDelete: Restrict)
  details  OrderDetail[]
  shipment Shipment?

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
}

model Shipment {
  id                String         @id @default(uuid()) @db.Uuid
  trackingNumber    String         @unique @default(cuid()) @db.VarChar(50)
  orderId           String         @db.Uuid
  vendorOrderId     String?        @unique @db.Uuid
  carrierId         String?        @db.Uuid
  carrierType       String         @default("employee") @db.VarChar(50)
  status            ShipmentStatus @default(pending)
  pickupAddress     String?        @db.VarChar(500)
  shippingAddress   String?        @db.VarChar(500)
  receiverName      String?        @db.VarChar(255)
  receiverPhone     String?        @db.VarChar(50)
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  failedReason      String?        @db.VarChar(500)
  notes             String?        @db.VarChar(1000)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorOrder VendorOrder?    @relation(fields: [vendorOrderId], references: [id], onDelete: SetNull)
  carrier     Employee?       @relation("EmployeeAssignedShipment", fields: [carrierId], references: [id], onDelete: SetNull)
  events      ShipmentEvent[]

  @@index([orderId])
  @@index([vendorOrderId])
  @@index([carrierId])
  @@index([status])
}

model ShipmentEvent {
  id          String         @id @default(uuid()) @db.Uuid
  shipmentId  String         @db.Uuid
  status      ShipmentStatus
  location    String?        @db.VarChar(255)
  description String?        @db.VarChar(500)
  actorRole   String?        @db.VarChar(50)
  actorId     String?        @db.Uuid
  createdAt   DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([createdAt])
}

